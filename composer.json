{
    "name":"igkdev/balafon",
    "description":"BALAFON PHP Framework",
    "license": "MIT",
    "require":{  
        "php":">=7.3"      
    },
    "authors": [
        {
            "name":"C.A.D BONDJE DOUE<goukenn>",
            "email":"cbondje@igkdev.com"
        }
    ],
    "bin": [
        "src/Lib/igk/bin/balafon"
    ],
    "autoload": {
        "psr-4": {
            "IGK\\": "src/Lib/igk/Lib/Classes"
        }
    },
    "scripts": {
        "post-autoload-dump": [ 
            "echo 'autoload-dump '",
            "IGK\\Composer\\Installer::PostInstall"
        ],
        "post-install-cmd": [
            "echo 'install balafon core '",
            "IGK\\Composer\\Installer::PostInstall"
        ]        
    }
}