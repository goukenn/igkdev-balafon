{
    "name":"igkdev/balafon",
    "description":"BALAFON PHP Framework",
    "license": "MIT",
    "require":{  
        "php":">=7.3"      
    },
    "authors": [
        {
            "name":"C.A.D BONDJE DOUE<goukenn>",
            "email":"cbondje@igkdev.com"
        }
    ],
    "bin": [
        "src/Lib/igk/bin/balafon"
    ],
    "autoload": {
        "psr-4": {
            "IGK\\": "src/Lib/igk/Lib/Classes"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "echo 'install balafon core '",
            "IGK\\Composer\\Installer::PostInstall",
            "chown -R www-data:www-data src/Lib/igk"
        ],
        "post-install-cmd": [
            "echo 'install balafon core '",
            "IGK\\Composer\\Installer::PostInstall",
            "chown -R www-data:www-data src/Lib/igk"
        ],
        "post-update-cmd": [
            "echo 'update balafon core '",
            "IGK\\Composer\\Installer::PostUpdate",
            "chown -R www-data:www-data vendor/balafon/src/Lib/igk"
        ]
    }
}