{
    "name":"igkdev/balafon",
    "description":"BALAFON PHP Framework",
    "license": "MIT",
    "require":{          
        "php":">=7.3"      
    },
    "keywords": [
        "Balafon", "IGKDEV", "C.A.D", "BONDJE"
    ],
    "authors": [
        {
            "name":"C.A.D BONDJE DOUE<goukenn>",
            "email":"c.bondje.doue@igkdev.com"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "bin": [
        "src/Lib/igk/bin/balafon"
    ],
    "autoload": {
        "psr-4": {
            "IGK\\": "src/Lib/igk/Lib/Classes"
        }
    },
    "scripts": {
        "post-autoload-dump": [ 
            "echo 'autoload-dump '",
            "IGK\\Composer\\Installer::PostInstall"
        ],
        "post-install-cmd": [
            "echo 'install balafon core '",
            "IGK\\Composer\\Installer::PostInstall"
        ] ,
        "test:phpunit": "phpunit" ,
        "test":[
            "@test:phpunit"
        ]      
    }
}