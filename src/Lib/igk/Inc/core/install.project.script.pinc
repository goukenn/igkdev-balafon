error_reporting(-1);
ini_set('display_errors', 1);

$response = new InstallerResponse();
if ($token != igk_getr('token')) {
    $response->die("missing token", 501);
}

class ProjectInstaller
{
    private $m_bdir;
    public function __construct(string $project_dir)
    {
        $this->m_bdir = $project_dir;
    }
    private function _path(string $path)
    {
        return implode(DIRECTORY_SEPARATOR, [$this->m_bdir, ltrim($path, DIRECTORY_SEPARATOR)]);
    }
    public function rmFile(string $path)
    {
        $l = implode(DIRECTORY_SEPARATOR, [$this->m_bdir, ltrim($path, DIRECTORY_SEPARATOR)]);
        return @unlink($l);
    }
    public function rmFiles(string $dir_path)
    {
        $l = implode(DIRECTORY_SEPARATOR, [$this->m_bdir, ltrim($dir_path, DIRECTORY_SEPARATOR)]);
        return InstallerHelper::RmFiles($l);
    }
    /**
     * just touch path 
     * @param string $path 
     * @return void 
     */
    public function touch(string $path)
    {
        touch($this->_path($path));
    }
    public function mkdir(string $path)
    {
        $p = $this->_path($path);
        if (!is_dir($d = dirname($p))) {
            return mkdir($d, 0777, true);
        }
    }
    /**
     * 
     * @param string $path 
     * @param mixed $content 
     * @return void 
     */
    public function write_content(string $path, $content)
    {
        $this->mkdir($path);
        $p = $this->_path($path);
        file_put_contents($p, $content);
    }
}

$preinstall = [];
$postinstall = [];
$version = 0;
$author = 0;
$count_file = 0;
$hzip = new \ZipArchive();
$appName = $install_dir = $error = null;
$steps = [];
$outdir = "";
$module_name = "";
$module_version = "";
$module_path = "";

 

$zip_out_dirname = igk_getr('project_entry');
$v_chome = rtrim($home, '/');
$corelib_dir = $v_chome . igk_getr('app_dir') . '/Lib/igk';
$install_dir = $v_chome . "/" . ltrim(igk_getr('install_dir'), '/');
$project_dir = rtrim($install_dir, "/") . "/" . ltrim(igk_getr('project_folder'), '/');
$tempzip = null;
$v_sys_tempdir = $install_dir . "/__temp";
$v_projectInstaller = new ProjectInstaller($project_dir);

$balafon = $corelib_dir . "/bin/balafon";
$project_name = igk_getr('project_name');

if (($php_cmd = InstallerHelper::GetPhpBinary()) && file_exists($balafon)) {
    $v_working_dir = igk_getr('working_dir') ?? InstallerHelper::LocateBaseDir($corelib_dir, 3); //.'/../../../../');
    $envs = [
        'IGK_WORKING_DIR' => $v_working_dir,
        'IGK_PACKAGE_DIR' => $v_working_dir . '/application/Packages',
        'IGK_MODULE_DIR' => $v_working_dir . '/application/Packages/Modules',
        'IGK_APP_DIR' => $v_working_dir . '/application',
        'IGK_PROJECT_DIR' => $v_working_dir . '/application/Projects'
    ];

    $pre = [];
    foreach ($envs as $k => $v) {
        $s = sprintf('%s=%s', $k, $v);
        //putenv($s);
        $pre[] = 'export ' . $s;
    }
    $pre = implode(';', $pre).";";
    $cwd = getcwd();
    chdir($v_working_dir);
    $install_project_command = [
        // '--clearcache',
        '--version',
        // '--db:initdb ' . $project_name.'Controller' 
    ];
    foreach($install_project_command as $install){
        $v_cmd = $pre."{$php_cmd} {$balafon} {$install} 1>&1 2>&1; echo \"\n\"$?";
        $r = (object)InstallerHelper::HandleBacktickCommand(`{$v_cmd}`);
        if ($r->exit_code!=0){
            $response->die(implode("\n", ['exec command failed :: ', 
            $v_cmd, json_encode($r, JSON_UNESCAPED_SLASHES)]));
        }
    }
    //echo 'v '. $v_working_dir. ' ; ' . file_exists($balafon) . PHP_EOL;
    // update all relative action div
    $c = $pre."{$php_cmd} '{$balafon}' --project:list --debug 1>&1 2>&1; echo \"\n\"$?";
    $r = InstallerHelper::HandleBacktickCommand(`{$c}`);
    // echo $c. PHP_EOL;
    // //b$r = InstallerHelper::HandleBacktickCommand(`{$php_cmd} {$balafon} --command:init  1>&1 2>&1; echo "\n"$?`); 
    echo json_encode($r, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES);
    exit;
    // echo ((object)$r)->output;
    chdir($cwd);
}


function post_install(&$postinstall, $f, $v_projectInstaller)
{
    $postinstall = ['post-installing'];
    $r = function () {
        extract(func_get_arg(1), EXTR_REFS);
        include(func_get_arg(0));
    };
    try {
        $r($f, ['log' => &$postinstall, 'installer' => &$v_projectInstaller]);
        return true;
    } catch (\Exception $ex) {
        $postinstall[] = 'failed:' . $ex->getMessage();
    }
    return false;
}
function pre_install(&$postinstall, $f, $v_projectInstaller)
{
    $postinstall = ['pre-installing'];
    $r = function () {
        extract(func_get_arg(1), EXTR_REFS);
        include(func_get_arg(0));
    };
    try {
        $r($f, ['log' => &$postinstall, 'installer' => &$v_projectInstaller]);
        return true;
    } catch (\Exception $ex) {
        $postinstall[] = 'failed:' . $ex->getMessage();
    }
    return false;
}


if (!file_exists($archive)) {
    $response->die(implode("\n", ["archive is not present: " . $archive, getcwd()]));
}

if ($archive && is_file($archive) && $hzip->open($archive)) {
    $error = false;
    if (!$error && (false !== ($g = $hzip->getStream("manifest.xml")))) {

        $data = "";
        while (!feof($g)) {
            $data .= fread($g, 4096);
        }
        fclose($g);
        $dc = (array)simplexml_load_string($data);
        isset($dc["author"]) ? $author = $dc["author"] : $error = true;
        isset($dc["version"]) ? $version = $dc["version"] : $error = true;

        if (isset($dc["@attributes"]["appName"])) {
            $appName = $dc["@attributes"]["appName"];
        } else {
            $error = true;
            $error_msg = "AppName is missing in manifest";
        }
        if (!$error) {
            $steps[] = "extract archive";
            $ln = strlen($zip_out_dirname);
            $temp_dir = $v_sys_tempdir;
            if (!is_dir($temp_dir)) {
                @mkdir($temp_dir, 0777, true);
            }
            $outdir = $temp_dir = tempnam($temp_dir, "prj");
            if (!is_dir($outdir)) {
                if (is_file($outdir)) {
                    unlink($outdir);
                }
                @mkdir($outdir, 0777, true);
            }
            for ($i = 0; $i < $hzip->numFiles; $i++) {
                $fname = $hzip->getNameIndex($i);
                if (preg_match("#^" . $zip_out_dirname . "/#", $fname) && ($fname[strlen($fname) - 1] != "/")) {
                    $path =  trim(substr($fname, $ln), "/");
                    // echo $fname.PHP_EOL;
                    // echo "extract to : ".$fname.PHP_EOL;
                    // echo "extract dir: ".$temp_dir.PHP_EOL;

                    $hzip->extractTo($temp_dir, $fname);
                    $count_file++;
                }
            }
            $outdir .= "/" . $zip_out_dirname;
        }
    } else {
        $error = true;
        $error_msg = "manifest file not found";
    }
    $hzip->close();

    @unlink($archive);
} else {
    $response->die("can't open archive", 501);
}
if (!$error) {
    if (file_exists($pc = $project_dir . '/[pre-publish].php')) {
        pre_install($preinstall, $pc, $v_projectInstaller);
    }

    if (is_dir($project_dir)) {
        $steps[] = "zip project directory";
        $tempzip = tempnam(sys_get_temp_dir(), "prj");;
        InstallerHelper::ZipFolder($tempzip, $project_dir);
        //
    }

    if (is_dir($project_dir)) {
        // before remove temp project directory - keep leavedir.
        $leave_dirs = false;
        if (file_exists($sync =  $project_dir . "/.balafon-sync.project.json")) {
            $cp = (object)json_decode(file_get_contents($sync));
            $leave_dirs = isset($cp->leavedirs) ? $cp->leavedirs : null;
            $steps[] = '************* leave dirs **************';
            if ($leave_dirs) {
                // remove directory - 
                $ln = strlen($project_dir);
                $steps[] = "remove project directory - and leavedirs";
                $regfist = false;
                igk_io_rmdir($project_dir, true, function ($v) use ($ln, $leave_dirs, &$regfist) {
                    $s = substr($v, $ln);
                    if (in_array($s, $leave_dirs) || in_array(dirname($s), $leave_dirs)) {
                        return false;
                    }
                    foreach ($leave_dirs as $k) {
                        $t = "/^\/" . ltrim(str_replace("/", "\\/", ($k)), '/') . "/";
                        $t = str_replace("**", "\/?([^\/]+\/?)(\/)?", $t);
                        $t = str_replace("*", "[^\/]+", $t);
                        if (preg_match($t, $s)) {
                            return false;
                        }
                    }
                    return true;
                });
            }
        }
        if (!$leave_dirs) {
            $steps[] = "remove project directory";
            igk_io_rmdir($project_dir);
        }
    }

    if ($outdir && is_dir($outdir)) {
        //if (project_dir)
        $steps[] = "move install dir : " . $outdir . " -> " . $project_dir;
        //
        if (!is_dir($project_dir)) {
            $steps[] = "***** rename dir *****";
            rename($outdir, $project_dir);
        } else {
            $steps[] = "***** merge dir *****";
            $cdir = [];
            $tfiles = igk_io_getfiles($outdir, "/.+/", true);
            $ln = strlen($outdir);
            $renamefile = 0;
            foreach ($tfiles as $fc) {
                $path = substr($fc, $ln);
                $out = $project_dir . "/" . ltrim($path, "/");

                if (file_exists($out)) {
                    continue;
                }

                $dir = dirname($out);
                if (!is_dir($dir)) {
                    if (isset($cdir[$dir])) {
                        continue;
                    }
                    if (!@mkdir($dir, 0775, true)) {
                        $cdir[$dir] = 1;
                        continue;
                    }
                }
                rename($fc, $out);
                $renamefile++;
            }
            $steps[] = "%%% remove temp dir %%";
            $steps[] =  "%% rename file : " . $renamefile . " %%";
            igk_io_rmdir($outdir);
        }
    }
    if ($tempzip) {
        $steps[] = "remove tempzip";
        unlink($tempzip);
        $tempzip = null;
    }
}
set_include_path(implode(PATH_SEPARATOR, [
    $corelib_dir . "/bin",
    $corelib_dir . "/Lib/Classes",
    $corelib_dir,
    get_include_path()
]));
putenv('PATH=' . implode(PATH_SEPARATOR, [$corelib_dir . "/bin", getenv('PATH')]));

if (!$error && file_exists($pc = $project_dir . '/[post-publish].php')) {
    post_install($postinstall, $pc, $v_projectInstaller);
}
// chmod($corelib_dir."/bin/balafon", 0777);


if ($php_cmd = InstallerHelper::GetPhpBinary()) {
    // $r = InstallerHelper::HandleBacktickCommand(`{$php_cmd} {$balafon} --version 1>&1 2>&1; echo "\n"$?`); 
    // echo json_encode($r, JSON_PRETTY_PRINT);
}

igk_io_rmdir($v_sys_tempdir);

$_vart = compact(
    "error",
    "version",
    "appName",
    "archive",
    "install_dir",
    "count_file",
    "author",
    "steps",
    "outdir",
    'preinstall',
    'postinstall'
);
if (!empty($error_msg)) {
    $_vart["error_msg"] = $error_msg;
}
$_vart['steps'][] = "send - response";
@unlink(__FILE__);
$response->Response(json_encode((object)$_vart, JSON_UNESCAPED_SLASHES), "application/json");
